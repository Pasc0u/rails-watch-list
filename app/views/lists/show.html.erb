<h1><%= @list.name %></h1>

<h2>Boookmarked movies</h2>
<ul>
<% @list.bookmarks.each do |bookmark| %>
  <% movie = bookmark.movie %>
  <li><img src="<%= movie.poster_url %>" alt="<%= movie.title %>" style="height: 200px"></li>
  <div><%= movie.title %> - rating: <%= movie.rating %></div>
  <div><%= movie.overview %></div>
  <div><%= bookmark.comment %></div>
  <div><%= link_to "Delete", bookmark_path(bookmark), data: {turbo_method: :delete, turbo_confirm: "Are you sure?"} %></div>
  <br>
<% end %>
</ul>




<h2>Add a movie</h2>

<%= simple_form_for [@list, @bookmark] do |f| %>
  <%= f.error_notification %>
  <%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>
  <%= f.input :comment %>
  <%= f.association :movie %>
  <%= f.submit "Create bookmark", class: "btn btn-primary" %>
<% end %>

<h2>Reviews</h2>
<% @list.reviews.each do |review| %>
<p><%= review.rating %> stars - <%= review.comment %></p>
<% end %>

<h2>Add your review</h2>
<%= simple_form_for [@list, @review] do |f| %>
  <%= f.error_notification %>
  <%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>
  <%= f.input :comment %>
  <%= f.input :rating %>
  <%= f.submit "Create Review", class: "btn btn-primary" %>
<% end %>

<%= link_to "Link to all lists", lists_path %>
