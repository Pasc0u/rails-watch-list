<h1><%= @list.name %></h1>

<h2>Boookmarked movies</h2>
<% @bookmarks.each do |bookmark| %>
<%= bookmark.movie.title %>
<%= bookmark.comment %>
<%= link_to "Delete", bookmark_path(bookmark), data: {turbo_method: :delete, turbo_confirm: "Are you sure?"} %>
<% end %>




<h2>Create a bookmark</h2>

<%= simple_form_for [@list, @bookmark] do |f| %>
  <%= f.error_notification %>
  <%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>
  <%= f.input :comment %>
  <%= f.association :movie %>
  <%= f.submit "Create bookmark", class: "btn btn-primary" %>
<% end %>

<h2>Reviews</h2>
<% @reviews.each do |review| %>
<%= review.rating %>
<%= review.comment %>
<% end %>

<h2>Add your review</h2>
<%= simple_form_for [@list, @review] do |f| %>
  <%= f.error_notification %>
  <%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>
  <%= f.input :comment %>
  <%= f.input :rating %>
  <%= f.submit "Create Review", class: "btn btn-primary" %>
<% end %>
